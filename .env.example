# Free API key from https://openrouter.ai/keys (only :free models are used, so no charges).
OPENROUTER_API_KEY=replace_with_your_openrouter_key

# Optional overrides. Models in each list are tried in order; local Ollama is the last fallback.
# GENERATOR_MODELS=nvidia/nemotron-3.5-lightning:free,google/gemma-4-31b-it:free,nvidia/nemotron-3-ultra-550b-a55b:free
# CRITIC_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-31b-it:free,nvidia/nemotron-3.5-lightning:free
# OLLAMA_MODEL=llama3
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Self-correction loop limits.
# MAX_RETRIEVALS=3
# MAX_GENERATIONS=2
